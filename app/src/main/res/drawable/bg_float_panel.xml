<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮面板背景：暖白半透明 + 橙色描边 + 大圆角（毛玻璃感） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#F2FFF8F2"
        android:endColor="#F2FFF0E0"
        android:angle="315" />
    <stroke
        android:width="1.2dp"
        android:color="#55E65100" />
    <corners android:radius="22dp" />
</shape>
