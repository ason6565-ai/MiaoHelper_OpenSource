<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF8F2" />

    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 顶部标题 + 菜单按钮 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvStatus"
                    android:text="@string/status_default"
                    android:textSize="12sp"
                    android:textColor="#8D6E63"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnMenu"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ui_menu"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- 左右滑动分页：第1页开关 / 第2页跳转 -->
        <!-- 无障碍未开启时的引导按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnA11yGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/ui_a11y_go_enable"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone"
            app:backgroundTint="#E65100"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_a11y"
            app:iconTint="#FFFFFF"
            app:iconPadding="6dp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部圆点指示器 -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/dot0"
                android:layout_width="10dp"
                android:layout_height="10dp" />
            <View
                android:id="@+id/dot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVersion"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#A1887F"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
