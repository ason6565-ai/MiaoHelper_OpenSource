<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 开关网格：悬浮球/实时翻译/句尾口癖/AI二次校验/彻底替换/流式输出/结果预览 -->
        <!-- 行1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileFloat"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="悬浮球"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvFloatState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileRealtime"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="实时翻译"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvRealtimeState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 行2 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileTail"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="句尾口癖"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvTailState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileVerify"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="AI 二次校验"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvVerifyState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 行3：彻底替换 + AI 并联本地（2×4 网格） -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileReplace"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="彻底替换"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvReplaceState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileLocalPre"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="AI 并联本地"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvLocalPreState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 行4 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileStream"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="流式输出"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvStreamState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tilePreview"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="84dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#22E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:text="结果预览"
                        android:textSize="14sp"
                        android:textColor="#3E2723"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvPreviewState"
                        android:text="关"
                        android:textSize="13sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 翻译引擎（保留底部） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFF3E0"
            app:strokeColor="#FFCC80"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="翻译引擎"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <com.miao.helper.SegmentedSlider
                    android:id="@+id/sgEngine"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
