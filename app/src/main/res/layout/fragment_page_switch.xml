<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 行1：悬浮球 / 实时翻译 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileFloat"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#40E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivFloat"
                        android:src="@drawable/ic_tile_float"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:text="@string/ui_tile_float"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvFloatState"
                        android:text="@string/sw_off"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileRealtime"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#40E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivRealtime"
                        android:src="@drawable/ic_tile_realtime"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:text="@string/ui_tile_realtime"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvRealtimeState"
                        android:text="@string/sw_off"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 行2：句尾口癖 / AI 二次校验 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileTail"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#40E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivTail"
                        android:src="@drawable/ic_tile_tail"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:text="@string/ui_tile_tail"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvTailState"
                        android:text="@string/sw_off"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileVerify"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#40E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivVerify"
                        android:src="@drawable/ic_tile_verify"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:text="@string/ui_tile_verify"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvVerifyState"
                        android:text="@string/sw_off"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 行3：彻底替换 / AI 并联本地（AI 功能组） -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileReplace"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#40E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivReplace"
                        android:src="@drawable/ic_tile_replace"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:text="@string/ui_tile_replace"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvReplaceState"
                        android:text="@string/sw_off"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileLocalPre"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#40E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivLocalPre"
                        android:src="@drawable/ic_tile_localpre"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:text="@string/ui_tile_localpre"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvLocalPreState"
                        android:text="@string/sw_off"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 结果预览（AI 翻译已隐藏，预览保留为通用投递确认） -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tilePreview"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:layout_marginStart="0dp"
                app:cardBackgroundColor="#00FFFFFF"
                app:strokeColor="#40E65100"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="#22E65100">
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ivPreview"
                        android:src="@drawable/ic_tile_preview"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:text="@string/ui_tile_preview"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvPreviewState"
                        android:text="@string/sw_off"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 翻译引擎（保留底部） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFF3E0"
            app:strokeColor="#FFCC80"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/ui_engine_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <com.miao.helper.SegmentedSlider
                    android:id="@+id/sgEngine"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
